# Postgres connection (Neon, Supabase or local). Use the pooled URL on serverless hosts.
DATABASE_URL=postgres://textrpg:textrpg@localhost:5432/textrpg
# Optional: Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/notify (Vercel Cron sends it as a bearer token)
CRON_SECRET=
